# Uncomment only the values you set. Never commit a real token. wenna refuses a
# variable that is set but empty, and Docker Compose reads `.env.wenna` copied
# from this file, so every line stays commented until it has a value. The
# backend's variables, defaults and rules are listed in one place: the package
# comment of backend/internal/config. Read once by that package.

# SQLite database file, an absolute path. Optional (unset =
# $HOME/.wenna/wenna.db; the Docker image sets its own). Every wenna process on
# the machine should use the same one: that is what makes it one memory.
# WENNA_DB=

# Bearer token for `wenna serve` (required there, 32+ bytes; unused by stdio
# and export). Generate one: openssl rand -hex 32. With Docker Compose it
# comes from the shell, never this file.
# WENNA_TOKEN=

# `wenna serve` listen port. Optional (unset = 8080).
# PORT=8080

# `wenna serve` listen address: an IP literal. Optional (unset = 127.0.0.1;
# the Docker image sets 0.0.0.0). Only loopback (127.0.0.1 or ::1) unless
# WENNA_BEHIND_TLS_PROXY=true: the server speaks plain HTTP, so the token and
# memories would cross the network unencrypted.
# WENNA_LISTEN_HOST=127.0.0.1

# `true` only when a proxy that terminates HTTPS sits in front of every
# request (HOSTING.md). Optional (unset = false).
# WENNA_BEHIND_TLS_PROXY=false

# Trigram index, so recall matches text inside a word ("foods" finds
# "atlasfoods.com"); the database grows to several times your memories' text
# and writes slow down — watch its size once memory is large. `false` saves the
# space. Set by you; nothing supplies it. Optional (unset = true). Processes
# sharing a database may differ.
# WENNA_TRIGRAM=true

# The https address apps use to reach wenna, e.g. https://<machine>.<tailnet>.ts.net.
# Set it when a proxy forwards to wenna on this machine without rewriting the
# Host header (Tailscale Funnel); not needed with Cloudflare Tunnel. Optional.
# With WorkOS, WENNA_WORKOS_RESOURCE must be this + /api/mcp.
# WENNA_PUBLIC_URL=

# OAuth through Cloudflare Access (docs/oauth/cloudflare.md). Optional: set all
# three or none. Team domain: Zero Trust settings (`<team>.cloudflareaccess.com`).
# AUD tag: the Access application's overview. Owner email: the address that
# signs in through Access.
# WENNA_ACCESS_TEAM_DOMAIN=
# WENNA_ACCESS_AUD=
# WENNA_ACCESS_OWNER_EMAIL=

# OAuth through WorkOS AuthKit (docs/oauth/workos.md). Optional: set all three
# or none. Issuer: `https://<AuthKit domain>` from the WorkOS dashboard.
# Resource: this instance's public MCP URL, ending in /api/mcp, exactly as
# entered as the Resource Indicator, e.g. https://memory.example.com/api/mcp. Owner ID: the owner's
# WorkOS user ID (`user_…`), from the dashboard's Users page.
# WENNA_WORKOS_ISSUER=
# WENNA_WORKOS_RESOURCE=
# WENNA_WORKOS_OWNER_ID=
